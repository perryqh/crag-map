<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission: everything ships bundled and is read from local
         files at runtime. ACCESS_FINE_LOCATION drives the on-map GPS "you are here"
         dot — GPS works via satellites, no signal needed, matching the offline design. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".CragMapApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.CragMap"
        android:usesCleartextTraffic="true">

        <!-- usesCleartextTraffic is required because the local tile server is
             plain http://127.0.0.1 — traffic never leaves the device. -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
